# Contact form email delivery (optional).
# The contact form works without these — submissions are logged to the server
# console. To actually receive emails, sign up at https://resend.com (free tier),
# create an API key, and set the values below in your hosting provider (e.g. Vercel).

RESEND_API_KEY=
CONTACT_TO_EMAIL=andrebeworkin@gmail.com

# Optional: a verified sender address on your own domain.
# Defaults to onboarding@resend.dev for quick testing.
CONTACT_FROM_EMAIL=
